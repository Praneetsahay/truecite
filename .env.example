# Copy to .env.local and fill in what you have. Everything is optional for local use:
# without API keys, scans answer from the built-in simulator and say so.

# AI providers (server only, never exposed to the browser)
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
ANTHROPIC_API_KEY=

# Email alerts and reports through Resend. Without a key, emails are recorded in the outbox table.
RESEND_API_KEY=
EMAIL_FROM="TrueCite <alerts@your-domain.example>"
# Where plan change requests and free check notifications go.
TRUECITE_TEAM_EMAIL=

# Protects the scheduled-scan endpoint (/api/cron/scans). Send it as "Authorization: Bearer <secret>".
CRON_SECRET=

# Production database (for example Supabase Postgres). Unset = local PGlite in .data/pglite.
DATABASE_URL=
# Where the local PGlite database lives.
# PGLITE_DIR=.data/pglite

# Dates and times are shown in this time zone.
NEXT_PUBLIC_DISPLAY_TIME_ZONE=Asia/Kolkata

# Optional path to Chrome or Edge for PDF reports when it isn't in the default location.
# CHROME_PATH=
